<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="tests/bootstrap.php"
         colors="true"
         processIsolation="false"
         stopOnFailure="false"
         cacheResult="false">
    <testsuites>
        <testsuite name="Schedules Test Suite">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
</phpunit>
